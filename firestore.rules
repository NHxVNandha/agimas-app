rules_version = '2';
// Firebase Console → Firestore Database → Rules → tempel seluruh isi file ini → Publish.
// Hanya email admin di bawah yang boleh menyimpan; semua orang boleh membaca data driver & tarif.
// Tambah admin lain: ['kurnianhxvnandha@gmail.com', 'admin2@gmail.com']
service cloud.firestore {
  match /databases/{database}/documents {
    match /app/data {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.token.email in ['kurnianhxvnandha@gmail.com']
        && request.resource.data.keys().hasOnly(['json'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 200000;
    }
  }
}
